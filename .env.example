# Keš (opciono) — Upstash Redis REST. Na Vercelu ih postavlja Redis integracija.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# AI analiza rezultata (opciono) — besplatan ključ iz Google AI Studio:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opciono: konkretan model (npr. gemini-2.5-flash). Ako nije zadat ili nije
# dostupan, koristi se "gemini-flash-latest" pa rezervni modeli.
GEMINI_MODEL=
